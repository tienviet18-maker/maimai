# MaiMai — Cloudflare Pages / local tooling
# Set these in Cloudflare Dashboard → Pages → Settings → Environment variables
# Build command will inject them into window.__MAIMAI_SUPABASE__ (see tools/build_web.js).
#
# NEVER commit real secrets. NEVER put service_role in the frontend.

# Canonical production host
MAIMAI_CANONICAL_URL=https://maimai.vimai.jp

# Supabase (publishable / anon key only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Aliases accepted by build_web.js
# MAIMAI_SUPABASE_URL=
# MAIMAI_SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
