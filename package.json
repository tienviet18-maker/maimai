{
  "name": "maimai",
  "version": "2.0.0",
  "description": "MaiMai — ViMai Ecosystem health companion (Capacitor SPA + Cloudflare Pages)",
  "private": true,
  "scripts": {
    "test": "node tools/run_tests.js",
    "relabel:foods": "node tools/relabel_foods_v2.js",
    "import:ifct": "node tools/import_ifct2017.js",
    "build": "node tools/build_web.js",
    "build:web": "node tools/build_web.js",
    "build:pages": "node tools/build_web.js",
    "preview": "npx --yes serve dist -l 4173",
    "patch:www": "node tools/patch_www_bridge.js",
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:android:debug": "cd android && .\\gradlew.bat assembleDebug",
    "build:android:release": "cd android && .\\gradlew.bat bundleRelease",
    "vendor": "node tools/vendor_assets.js",
    "build:css": "node tools/vendor_assets.js",
    "android:v2": "node tools/android_v2_prepare.js && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@supabase/supabase-js": "^2.49.8",
    "chart.js": "^4.5.1",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=22"
  }
}
