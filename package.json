{
  "name": "maimai",
  "version": "1.1.0",
  "description": "MaiMai — ViMai Ecosystem health companion (Capacitor SPA + Cloudflare Pages)",
  "private": true,
  "scripts": {
    "build": "node tools/build_web.js",
    "build:web": "node tools/build_web.js",
    "build:pages": "node tools/build_web.js",
    "preview": "npx --yes serve dist -l 4173",
    "patch:www": "node tools/patch_www_bridge.js",
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:android:debug": "cd android && .\\gradlew.bat assembleDebug",
    "build:android:release": "cd android && .\\gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.0.3",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/status-bar": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
